# Omite .env.local para utilizar los 20 registros de data/muestra.json.
VITE_DATA_SOURCE=local

# Para Realtime Database: VITE_DATA_SOURCE=firebase y completa estas variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
